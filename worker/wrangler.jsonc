{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b2e-leads",
  "main": "src/index.js",
  "compatibility_date": "2026-04-25",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE_VISIT_COUNTER",
        "class_name": "SiteVisitCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_site_visit_counter",
      "new_sqlite_classes": [
        "SiteVisitCounter"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://efnatii.github.io",
    "SITE_LABEL": "ООО B2E",
    "LEAD_SUBJECT": "Новая заявка на металлоконструкции"
  }
}
