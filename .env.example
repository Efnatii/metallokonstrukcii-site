# Public build values baked into dist/config.js.
# For production, scripts/Deploy-YandexCloud.ps1 sets B2E_SITE_URL to the
# public HTTPS site URL. When the site is served from a domain bucket, API
# endpoints stay absolute on the Yandex API Gateway URL.
B2E_SITE_URL=https://<gateway-domain>/
B2E_CONTACT_PHONE=+79650578270
B2E_CONTACT_PHONE_DISPLAY=+7 (965) 057-82-70
B2E_WORK_HOURS=Пн-Пт 09:00 - 18:00
B2E_CONTACT_EMAIL=zakaz@b2energy.ru
B2E_MAX_URL=https://max.ru/u/f9LHodD0cOIq9CnGVeR2XIVeHPu_GpeOl3tdE_eGIeC3kbz6i8FikJr_4IM
B2E_ADDRESS=Санкт-Петербург, ул. Седова, 57, лит. В, помещ. 11-Н, ком. 3
B2E_YANDEX_MAP_URL=https://yandex.ru/maps/-/CPSAzCMe
B2E_YANDEX_ROUTE_URL=https://yandex.ru/maps/?mode=routes&rtext=~59.879804%2C30.425277&rtt=auto
# Optional public map iframe URL kept for compatibility; the visible site map is Leaflet with 4 locations.
B2E_YANDEX_MAP_EMBED_URL=https://yandex.ru/map-widget/v1/?ll=30.425277%2C59.879804&mode=whatshere&whatshere%5Bpoint%5D=30.425277%2C59.879804&whatshere%5Bzoom%5D=17&z=17
B2E_RBC_PROFILE_URL=https://companies.rbc.ru/amp/ogrn/1247800091098/
B2E_RUSPROFILE_URL=https://www.rusprofile.ru/id/1247800091098
B2E_CATALOG_URL=./assets/documents/b2e-metallokonstrukcii-catalog.pdf
B2E_LEAD_ENDPOINT=/api/leads
B2E_STATS_ENDPOINT=/api/stats

# Public Yandex Cloud deployment names. These are not secrets.
YANDEX_PROJECT_NAME=b2e-metallokonstrukcii
YANDEX_SITE_BUCKET=metallb2e.ru
YANDEX_STATS_BUCKET=b2e-metallokonstrukcii-stats
YANDEX_FUNCTION_NAME=b2e-leads
YANDEX_GATEWAY_NAME=b2e-metallokonstrukcii-gateway
YANDEX_SERVICE_ACCOUNT_NAME=b2e-metallokonstrukcii-sa
YANDEX_SECRET_NAME=b2e-metallokonstrukcii-smtp
YANDEX_FUNCTION_RUNTIME=nodejs22
YANDEX_FUNCTION_MEMORY=256MB
YANDEX_FUNCTION_TIMEOUT=15s

# Optional domain foundation. Set both values when the certificate exists in Yandex Certificate Manager.
YANDEX_CUSTOM_DOMAIN=
YANDEX_CERTIFICATE_ID=
YANDEX_ALLOWED_ORIGIN=

# Optional repeat deploy mode when the Lockbox secret already exists.
YANDEX_SKIP_SECRET_UPDATE=false
YANDEX_FUNCTION_SECRET_KEYS=SMTP_HOST,SMTP_PORT,SMTP_SECURE,SMTP_USERNAME,SMTP_PASSWORD,SMTP_FROM,SMTP_FROM_NAME,SMTP_ENVELOPE_FROM,SMTP_TO

# GitHub Actions secrets for Yandex Cloud CLI auth.
# Do not commit real values.
YC_SERVICE_ACCOUNT_KEY_JSON=
YC_CLOUD_ID=
YC_FOLDER_ID=

# Private runtime secrets uploaded to Yandex Lockbox and mounted into Cloud Functions.
# At least one delivery channel must be configured.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_ENVELOPE_FROM=
SMTP_TO=
LEAD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Yandex SmartCaptcha server key. Keep it private.
SMARTCAPTCHA_SERVER_KEY=

# Optional legacy fallback only. Prefer SMARTCAPTCHA_SERVER_KEY for the Yandex Cloud deployment.
TURNSTILE_SECRET_KEY=
